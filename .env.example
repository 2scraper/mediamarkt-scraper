# mediamarkt-scraper — credentials and defaults
#
# Copy this file to `.env` next to the scripts and fill in what you use:
#
#     cp .env.example .env
#
# `.env` is in .gitignore. Keep it there. A secret passed on a command line
# is readable by anything that can run `ps` and lands in your shell history,
# which is why none of these has a flag you are expected to type.
#
# Precedence, highest first:
#
#     explicit CLI flag  >  exported environment variable  >  .env  >  default
#
# So a `.env` never overrides something you typed, and an already-exported
# variable (a CI secret, direnv, your shell profile) is never clobbered by a
# file you forgot to delete.
#
# Check what was picked up, without printing any secret:
#
#     python3 env_config.py
#
# Every variable below is one this code actually reads, and every variable
# the code reads is below — smoke_test.py asserts the two sets are equal in
# both directions, because a documented-but-unread variable is worse than an
# undocumented one.


# --- 2Captcha -------------------------------------------------------------
# One key, four separately-billed products: captcha solving, the Scraping
# Browser API, proxies and fingerprints. https://2captcha.com
#
# Worth knowing before you buy solving for this site: MediaMarkt's refusal is
# an HTTP 403 carrying its own branded error page, with no challenge on it to
# solve. A key does nothing about that — a residential exit does. This key is
# for the reCAPTCHA the site uses on account and checkout flows, and for
# --fingerprint.
TWOCAPTCHA_KEY=your_2captcha_api_key_here

# --- Scraping Browser API -------------------------------------------------
# A remote browser you do not run or patch, with a persistent profile and a
# chosen exit country. Used by --cdp-endpoint.
#
#   country-  picks the exit country, and therefore which country site a
#             cookie-less visit is redirected to, along with its currency.
#             For mediamarkt.de you want a German exit.
#   pid-      is a profile with persistent cookies. ONE live connection each,
#             capped per account — reuse pids rather than minting one per
#             run, and expect a 500 from the endpoint while another run still
#             holds this one.
#
# Note that Selenium cannot use this: chromedriver's `debuggerAddress` takes
# a bare host:port with nowhere to put a password. Playwright and pyppeteer
# authenticate on the WebSocket upgrade and work.
MEDIAMARKT_CDP_ENDPOINT=ws://{login}-zone-scraping_browser-country-de-pid-{profileId}:{password}@cb.2captcha.com:9222

# --- Proxy ----------------------------------------------------------------
# The one thing this site genuinely requires. Measured 2026-09-09: every
# datacentre and VPN address tested received HTTP 403 on every URL of every
# country site, in a real browser as well as a plain HTTP client, while the
# same request from a German residential address returned the full page.
#
# One URL. For a pool, use --proxy-file with one per line: a pool is what
# spreads a run's volume, and --concurrency without one just sends N times
# the traffic from a single address.
#
# The credentials here never reach the browser's command line — they go
# through the driver's own fields. Logs keep the host and port and mask the
# rest, because which exit a run used is the point of the log and is not the
# secret.
MEDIAMARKT_PROXY=http://{user}:{password}@eu.proxy.2captcha.com:2334

# --- Default target -------------------------------------------------------
# Saves retyping --url. Any of the eleven country sites; the hostname decides
# which, so there is no --country flag that could disagree with the URL.
#
# Careful with category URLs: some are HUB pages that list sub-categories and
# carry no product grid at all (/de/category/notebooks-680.html is one). They
# answer 200 and yield zero rows, which is exit 4 and not a fault.
MEDIAMARKT_URL=https://www.mediamarkt.de/de/category/k%C3%BChlen-gefrieren-32.html

# Deliberately NOT here: an output prefix. `--out` already carries a
# non-empty default, so the loader — which only fills UNSET values — would
# never see it, and the variable would be silently inert: a setting that
# looks configurable and is not.
